### File variables
@PAP-HOST = pap-provider.127.0.0.1.nip.io:8080


### 01. Get the policy list
GET http://{{PAP-HOST}}/policy


### 02. Delete a policy
@02_POLICY-ID = qwnvxrboic

DELETE http://{{PAP-HOST}}/policy/{{02_POLICY-ID}}


######################################################################################
#### P1: allow any participant to use the /ngsi-ld/v1/entities path and the iot/d path
######################################################################################

### Basic usage policy for /ngsi-ld/v1/entities path

POST http://{{PAP-HOST}}/policy
Content-Type: application/json

{ 
    "@context": {
        "odrl": {
            "@id": "http://www.w3.org/ns/odrl/2/",
            "@prefix": true
        },
        "dome-op": {
            "@id": "https://github.com/DOME-Marketplace/dome-odrl-profile#",
            "@prefix": true
        },
        "xsd": {
            "@id": "http://www.w3.org/2001/XMLSchema#",
            "@prefix": true
        }
    },
    "@id": "https://mp-operation.org/policy/common/type/ds-use",
    "@type": "odrl:Policy",
    "odrl:permission": {
        "odrl:assigner": {
            "@id": "https://www.mp-operation.org/"
        },
        "odrl:target": {
            "@type": "odrl:AssetCollection",
            "odrl:source": "urn:asset",
            "odrl:refinement": [
                {
                    "@type": "odrl:Constraint",
                    "odrl:leftOperand": "http:path",
                    "odrl:operator": {
                        "@id": "http:isInPath"
                    },
                    "odrl:rightOperand": {
                        "@value": "/ngsi-ld/v1/entities",
                        "@type": "xsd:string"
                    }
                }
            ]
        },
        "odrl:assignee": {
            "@id": "vc:any"
        },
        "odrl:action": {
            "@id": "odrl:use"
        }
    }
}

