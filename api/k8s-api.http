### POST /iot/json - Air Quality Observed
#POST http://{{IOTA_HOST_S}}/iot/d?k=TEF&i={{DEVICE_ID_AQ}}
POST http://{{IOTA_HOST_S}}/iot/d?k={{APIKEY_AQ}}&i={{DEVICE_ID_AQ}}
Authorization: Bearer {{USER_ACCESS_TOKEN}}
Content-Type: application/json
fiware-service: openiot
fiware-servicepath: /

{
    "type": "AirQualityObserved",
    "temperature": "23.6",
    "relativeHumidity": "51.4",
    "atmosphericPressure": "1013.25"
}


### GET /ngsi-ld/v1/entity - Air Quality Observed
GET http://{{DATA_SERVICE_HOST}}/ngsi-ld/v1/entities/urn:ngsi-ld:AirQualityObserved:SPVS01_AQ
Accept: application/ld+json
NGSILD-Tenant: openiot
NGSILD-Path: /
Authorization: Bearer {{USER_ACCESS_TOKEN}}


### GET /ngsi-ld/v1/entity - Air Quality Observed
GET http://{{DATA_SERVICE_HOST}}/ngsi-ld/v1/entities?type=AirQualityObserved
Accept: application/ld+json
NGSILD-Tenant: openiot
NGSILD-Path: /
Authorization: Bearer {{SPVS_MANAGER_TOKEN}}











